# ============================================================
# 环境变量占位模板
# 复制为 .env 并填入真实值。此处为脱敏占位，无任何真实凭据。
# ============================================================

# -------- 项目标识（请替换为你自己的）--------
# 本项目是通用的「游戏视频逐字稿内容审查」框架，不绑定任何具体产品。
GAME_TITLE=
GAME_DEVELOPER=
GAME_PUBLISHER=
YT_KEYWORD=
BILI_KEYWORD=

# -------- 飞书 (Feishu) --------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_TOKEN=
BILIBILI_TABLE_ID=
YOUTUBE_TABLE_ID=
CREATOR_TABLE_ID=
CURATED_TABLE_ID=

# -------- Discord --------
# 目标频道映射：频道ID=语义名，多个用英文逗号分隔
# 获取频道 ID：Discord 设置 → 高级 → 开启开发者模式 → 右键频道 → 复制频道 ID
DISCORD_CHANNELS=
# 服务器 ID（用于拼接帖子永久链接）
DISCORD_GUILD_ID=
# 频道采集时间上限（天）：频道ID=天数，逗号分隔；未列出的频道不限制
DISCORD_CHANNEL_MAX_AGE=
# 视频自荐标记的目标频道
DISCORD_VIDEO_CHANNEL_ID=
# 会话凭据（由部署者自行配置，仅用于本地自动化）
DISCORD_USER_TOKEN=
DISCORD_FETCH_LIMIT=

# -------- YouTube API / Cookie --------
YT_API_KEY=
YT_ENABLE_PLAYWRIGHT=
YT_LOGIN_INFO=
YT_SID=
YT_HSID=
YT_COOKIE=
YOUTUBE_COOKIE=

# -------- AI 审核（OpenAI 兼容协议）--------
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_CHEAP=
AI_MODEL_HEAVY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_CHEAP=
DEEPSEEK_MODEL_HEAVY=
DEEPSEEK_CHEAP_THRESHOLD=

# -------- Bilibili --------
BILIBILI_COOKIE=
BILIBILI_MAX_WORKERS=
BILIBILI_REQUEST_INTERVAL=

# -------- 运行参数 --------
MAX_SUBTITLE_CHARS=
MAX_WORKERS=
HISTORY_MAX_SIZE=
HTTP_PROXY=
HTTPS_PROXY=
